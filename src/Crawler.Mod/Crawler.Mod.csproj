<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">

  <Import Project=".\Sts2PathDiscovery.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>VampireCrawler</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
    <PathMap>$(AppOutputBase)=.\</PathMap>
    <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);.godot/**;.godot\**</DefaultItemExcludes>
    <PckPath>$(MSBuildProjectDirectory)\$(AssemblyName).pck</PckPath>
    <DotNetRoot Condition="'$(DotNetRoot)' == '' and Exists('$(USERPROFILE)\.dotnet\dotnet.exe')">$(USERPROFILE)\.dotnet</DotNetRoot>
    <GodotExportPrefix Condition="'$(DotNetRoot)' != ''">set &quot;DOTNET_ROOT=$(DotNetRoot)&quot; &amp;&amp; set &quot;PATH=$(DotNetRoot);%PATH%&quot; &amp;&amp; </GodotExportPrefix>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(Sts2DataDir)')">
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="*" PrivateAssets="All" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All" />
    <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="*" />
    <AdditionalFiles Include="VampireCrawler/localization/**/*.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove=".godot/**" />
    <Compile Remove="VampireCrawler/**" />
    <EmbeddedResource Remove=".godot/**" />
    <EmbeddedResource Remove="VampireCrawler/**" />
  </ItemGroup>

  <ItemGroup>
    <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props" />
    <None Remove=".godot/**" />
    <None Include="VampireCrawler.json" />
    <None Include="project.godot" />
    <None Include="export_presets.cfg" />
    <None Include="Sts2PathDiscovery.props" />
    <None Include="local.props.example" />
    <None Include="VampireCrawler/**" />
    <ModResourceFiles Include="VampireCrawler/**" />
  </ItemGroup>

  <Target Name="CheckDependencyPaths">
    <Error Text="Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
           Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
  </Target>

  <Target Name="RemoveGodotTempCompileItems" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="$(MSBuildProjectDirectory)\.godot\**\*.cs" />
    </ItemGroup>
  </Target>

  <Target Name="StageGodotExportRuntimeReferences"
          BeforeTargets="ExportVampireCrawlerPck"
          Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)')">
    <ItemGroup>
      <GodotExportRuntimeReferences Include="$(Sts2DataDir)\sts2.dll" Condition="Exists('$(Sts2DataDir)\sts2.dll')" />
      <GodotExportRuntimeReferences Include="$(Sts2DataDir)\0Harmony.dll" Condition="Exists('$(Sts2DataDir)\0Harmony.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(GodotExportRuntimeReferences)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ExportVampireCrawlerPck"
          BeforeTargets="CopyToModsFolderOnBuild"
          Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)')">
    <Message Text="Exporting $(AssemblyName).pck with Godot." Importance="high" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="$(GodotExportPrefix)&quot;$(GodotPath)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;BasicExport&quot; &quot;$(PckPath)&quot;" />
  </Target>

  <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent">
    <Message Text="Copying .dll, .pdb, and .json to mods folder." Importance="high" />
    <RemoveDir Directories="$(ModsPath)$(AssemblyName)" Condition="Exists('$(ModsPath)$(AssemblyName)')" />
    <MakeDir Directories="$(ModsPath)$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(AssemblyName)/" />
    <Copy SourceFiles="$(AssemblyName).json" DestinationFolder="$(ModsPath)$(AssemblyName)/" />
    <Copy SourceFiles="$(PckPath)" DestinationFolder="$(ModsPath)$(AssemblyName)/" Condition="Exists('$(PckPath)')" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModsPath)$(AssemblyName)/" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(ModsPath)$(AssemblyName)/" />
    <Copy SourceFiles="@(ModResourceFiles)" DestinationFiles="@(ModResourceFiles->'$(ModsPath)$(AssemblyName)/%(RecursiveDir)%(Filename)%(Extension)')" Condition="!Exists('$(PckPath)')" />
  </Target>

</Project>
